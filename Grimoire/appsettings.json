{
    "channelId": "",
    "warningChannelId": "",
    "warningReportTimeUtc": "09:00",
    "validImageExtensions": ".jpg,.jpeg,.png,.webp,.gif",
    "ConnectionStrings": {
        "Grimoire": ""
    },
    "ConnectionProperties": {
        "Hostname": "",
        "Port": "",
        "DbName": "",
        "Username": "",
        "Password": ""
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "System.Net.Http": "Warning",
                "Polly": "Warning",
                "ZiggyCreatures.Caching.Fusion": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {TraceId}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "WithExceptionDetails"
        ]
    },
    "token": "",
    "pluralkitToken": "",
    "pluralkitUserAgent": "",
    "pluralkitApiEndpoint": "https://api.pluralkit.me/v2/",
    "telemetryTraceUrl": ""
}
